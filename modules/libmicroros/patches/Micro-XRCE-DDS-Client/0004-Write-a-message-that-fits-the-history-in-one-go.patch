From 8ca99785cac98ed9f366ef577a5db6b151c62a32 Mon Sep 17 00:00:00 2001
From: Hao <hao3.li@tu-dortmund.de>
Date: Thu, 5 Nov 2026 22:48:00 +0000
Subject: [PATCH] Write a message that fits the history in one go

uxr_prepare_output_stream_fragmented wrote every message as if its first
fragment were full: it declared a whole block and set the slot to its
full capacity. rmw_publish falls back to it whenever
uxr_prepare_output_stream fails, including for small messages while the
history is full, so those went out with the old contents of the slot
after them, which crashed Agent v2.4.3. It also marked the first
fragment as last when the message did not fit it, which truncated
messages just over one block.

A message that fits the whole history now waits for free slots if
needed and is then written by uxr_prepare_output_stream, so it is never
left half written when that wait fails. Only a message larger than the
history is still written as slots free up.

Refs eProsima/Micro-XRCE-DDS-Client#423

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 src/c/core/session/write_access.c | 28 ++++++++++++++++++++++++++++
 1 file changed, 28 insertions(+)

diff --git a/src/c/core/session/write_access.c b/src/c/core/session/write_access.c
index 6ed7953..4a93ad0 100644
--- a/src/c/core/session/write_access.c
+++ b/src/c/core/session/write_access.c
@@ -215,6 +215,19 @@ bool on_full_output_buffer_fragmented(
     return false;
 }
 
+// Whether a WRITE_DATA submessage with this much data fits the whole history, split into
+// fragments if needed.
+static bool fits_history(
+        const uxrOutputReliableStream* stream,
+        size_t data_size)
+{
+    size_t payload_size = WRITE_DATA_PAYLOAD_SIZE + data_size;
+    size_t submessage_size = SUBHEADER_SIZE + payload_size + uxr_submessage_padding(payload_size);
+    size_t fragment_capacity = uxr_get_reliable_buffer_capacity(&stream->base)
+            - (size_t)(stream->offset + SUBHEADER_SIZE);
+    return submessage_size <= fragment_capacity * stream->base.history;
+}
+
 uint16_t uxr_prepare_output_stream_fragmented(
         uxrSession* session,
         uxrStreamId stream_id,
@@ -237,6 +250,21 @@ uint16_t uxr_prepare_output_stream_fragmented(
         return UXR_INVALID_REQUEST_ID;
     }
 
+    // A message that fits the whole history is written in one go by uxr_prepare_output_stream,
+    // after waiting for free slots if needed, so it is never left half written. Only a larger
+    // message is written below as slots free up.
+    if (fits_history(stream, data_size))
+    {
+        UXR_UNLOCK_STREAM_ID(session, stream_id);
+        rv = uxr_prepare_output_stream(session, stream_id, entity_id, ub, (uint32_t)data_size);
+        if (UXR_INVALID_REQUEST_ID == rv)
+        {
+            (void) flush_callback(session, flush_callback_args);
+            rv = uxr_prepare_output_stream(session, stream_id, entity_id, ub, (uint32_t)data_size);
+        }
+        return rv;
+    }
+
     UXR_LOCK_STREAM_STATE(stream);
     size_t remaining_blocks = get_available_free_slots(stream);
     UXR_UNLOCK_STREAM_STATE(stream);
